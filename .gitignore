# ===== .NET projects (UIConstraints.Core, UIConstraints.Core.Tests) =====
[Bb]in/
[Oo]bj/

# ===== Godot project (UIConstraints.Godot) =====
/UIConstraints.Godot/.godot/

# ===== Unity project (UIConstraints.Unity) =====
# Core is copied here by its build (see UIConstraints.Core.csproj), Unity generates the .meta files for it
/UIConstraints.Unity/Packages/uiconstraints/Runtime/Plugins/
/UIConstraints.Unity/Packages/uiconstraints/Runtime/Plugins.meta

# Based on https://github.com/github/gitignore/blob/main/Unity.gitignore, with paths adjusted to the Unity project directory
/UIConstraints.Unity/[Ll]ibrary/
/UIConstraints.Unity/[Tt]emp/
/UIConstraints.Unity/[Oo]bj/
/UIConstraints.Unity/[Bb]uild/
/UIConstraints.Unity/[Bb]uilds/
/UIConstraints.Unity/[Ll]ogs/
/UIConstraints.Unity/[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/UIConstraints.Unity/[Mm]emoryCaptures/

# Recordings can get excessive in size
/UIConstraints.Unity/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /UIConstraints.Unity/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/UIConstraints.Unity/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# JetBrains cache directory
.idea/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files (only Unity's, the other projects' files are hand written)
ExportedObj/
.consulo/
/UIConstraints.Unity/*.csproj
/UIConstraints.Unity/*.unityproj
/UIConstraints.Unity/*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/UIConstraints.Unity/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/UIConstraints.Unity/[Aa]ssets/[Ss]treamingAssets/aa.meta
/UIConstraints.Unity/[Aa]ssets/[Ss]treamingAssets/aa/*
