<Project Sdk="Microsoft.NET.Sdk">

  <!-- Renders the SVG icons to PNGs for engines that can't use SVGs as icons (Unity). Run it from the repository root, see Program.cs -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>UIConstraints.Icons</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Svg.Skia" Version="5.2.3" />
  </ItemGroup>

</Project>
